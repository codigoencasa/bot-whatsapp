{
  "name": "@builderbot/root",
  "version": "1.3.10",
  "description": "Bot de wahtsapp open source para MVP o pequeños negocios",
  "main": "app.js",
  "private": true,
  "scripts": {
    "clean": "npx lerna clean --y",
    "commit": "git-cz",
    "format:check": "prettier --check ./packages",
    "format:write": "prettier --write ./packages",
    "fmt.staged": "pretty-quick --staged",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix ./packages",
    "build:full": "pnpm run clean && pnpm i && pnpm run build",
    "build": "pnpm run clean.lib && npx lerna run build",
    "copy.lib": "tsm ./scripts/move.ts",
    "clean.lib": "tsm ./scripts/clean.ts",
    "generate.templates": "tsm ./scripts/generate/index.ts",
    "test:coverage": "npx lerna run test:coverage",
    "test:coverage:full": "npx lerna-lcov-aggregate && npx lcov-viewer lcov -o ./coverage/ ./coverage/lcov.info",
    "test": "npx lerna run test",
    "publish:canary": "npx lerna publish from-package --canary",
    "prepare": "npx husky install",
    "publish:dev": "npx lerna publish from-package --dist-tag dev --yes",
    "check:workspace-deps": "node ./scripts/check-workspace-deps.js",
    "next:version": "pnpm run check:workspace-deps && npx lerna version --force-publish",
    "preinstall": "npx only-allow pnpm",
    "release": "standard-version -- --prerelease --global",
    "generate:release-summary": "node ./scripts/generate-release-summary.js --version=$(node -p \"require('./lerna.json').version\")",
    "cli": "node ./packages/cli/bin/cli.cjs"
  },
  "keywords": [
    "whatsapp",
    "bot-whatsapp",
    "node-bot-whatsapp",
    "builderbot"
  ],
  "contributors": [
    {
      "email": "leifer33@gmail.com",
      "name": "Leifer Mendez",
      "url": "https://leifermendez.github.io"
    }
  ],
  "repository": "https://github.com/leifermendez/bot-whatsapp",
  "license": "ISC",
  "workspaces": [
    "packages/plugins/*",
    "packages/bot",
    "packages/cli",
    "packages/create-builderbot",
    "packages/database-mongo",
    "packages/database-mysql",
    "packages/database-json",
    "packages/database-postgres",
    "packages/eslint-plugin-builderbot",
    "packages/manager",
    "packages/provider-meta",
    "packages/provider-evolution-api",
    "packages/provider-baileys",
    "packages/provider-facebook-messenger",
    "packages/provider-gupshup",
    "packages/provider-instagram",
    "packages/provider-tiktok",
    "packages/provider-sherpa",
    "packages/provider-twilio",
    "packages/provider-web-whatsapp",
    "packages/provider-wppconnect",
    "packages/provider-telegram",
    "packages/provider-venom",
    "packages/provider-gohighlevel",
    "packages/provider-email",
    "packages/provider-voice",
    "packages/provider-voice-sip",
    "packages/provider-voice-whatsapp",
    "packages/contexts-dialogflow",
    "packages/contexts-dialogflow-cx"
  ],
  "devDependencies": {
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.1",
    "@lcov-viewer/cli": "^1.3.0",
    "@octokit/core": "^7.0.6",
    "@types/fs-extra": "^11.0.4",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "c8": "^10.1.3",
    "commitlint": "20.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "fs-extra": "^11.3.2",
    "git-cz": "^4.9.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lerna": "^9.0.3",
    "lerna-lcov-aggregate": "^1.0.0",
    "nx": "^22.2.0",
    "only-allow": "^1.2.2",
    "openai": "^6.10.0",
    "prettier": "^3.7.4",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.2",
    "rollup": "^4.53.3",
    "semver": "^7.7.3",
    "standard-version": "^9.5.0",
    "tslib": "^2.8.1",
    "tsm": "^2.3.0",
    "typescript-eslint": "^8.49.0",
    "uvu": "^0.5.6"
  },
  "packageManager": "pnpm@9.0.6",
  "engines": {
    "node": ">=20.12.1 <23.0.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": ">=8.6.12"
  },
  "author": "Leifer Mendez <leifer.contacto@gmail.com>"
}
